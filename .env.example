# Agent Zero Environment Variables
# Copy this file to .env and fill in your values

# API Keys (Required)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Authentication (Highly Recommended for Coolify)
UI_USERNAME=admin
UI_PASSWORD=your_secure_password_here
ROOT_PASSWORD=your_secure_root_password_here

# RFC (Remote Function Calls) Security
RFC_PASSWORD=your_rfc_password_here

# Application Settings
TZ=UTC
PUID=1000
PGID=1000

# Optional: External Services
# CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_token
# REDIS_URL=redis://redis:6379

# Security Settings
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com
SECURE_COOKIES=true
SESSION_TIMEOUT=3600

# Logging
LOG_LEVEL=INFO
MAX_LOG_SIZE=100MB
LOG_RETENTION_DAYS=30